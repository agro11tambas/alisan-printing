# Template .env untuk server produksi (Hostinger).
# Salin ke .env di server, lalu isi nilai yang kosong.
#
# Yang berbeda dari .env produksi per 5 Agustus 2026 ditandai dengan "# UBAH".

APP_NAME="Alisan Printing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erpalisan.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Timezone tidak diatur di sini. config/app.php sudah mengunci Asia/Jakarta,
# dan APP_TIMEZONE tidak dibaca sama sekali, jadi jam di log sudah WIB.

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Debugbar adalah dependency development. Baris ini membuatnya tidak ikut
# menyala kalau suatu saat APP_DEBUG dinyalakan untuk mengejar bug.
DEBUGBAR_ENABLED=false

LOG_CHANNEL=stack
# UBAH: "single" tidak pernah dirotasi, laravel.log tumbuh tanpa batas.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# Request lebih lama dari nilai ini dicatat ke storage/logs/performance-*.log
# oleh App\Http\Middleware\LogSlowRequests. Channel "performance" sengaja tidak
# mengikuti LOG_LEVEL, karena LOG_LEVEL=error membuang semua catatan itu.
SLOW_REQUEST_LOG_MS=1000
PERFORMANCE_LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
# 2628000 menit = 5 tahun. Sesi memang jadi tidak pernah logout sendiri, tapi
# Laravel juga tidak pernah menghapus baris lama di tabel sessions, padahal
# setiap request membaca dan menulis tabel itu. Cek dengan app:check-production.
SESSION_LIFETIME=2628000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# UBAH: situs sudah HTTPS, cookie sesi sebaiknya tidak pernah dikirim via HTTP.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Aman: tidak ada job yang di-dispatch di aplikasi ini (app/Jobs kosong),
# jadi tidak perlu queue worker berjalan.
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

IMAGE_UPLOAD_TOKEN=
# Kalau dikosongkan, dipakai default dari config/services.php.
IMAGE_UPLOAD_URL=https://image.alisanprinting.com/upload12552.php

FRONTEND_WEBSITE_URL=https://alisanprinting.com
ALLOWED_ORIGINS=http://localhost:3000,https://alisanprinting.com

# Alamat server Next.js yang menerima ping revalidate. Isi dengan alamat yang
# bisa dihubungi langsung dari server ERP (lewati CDN kalau ada), dan samakan
# secret-nya dengan REVALIDATE_SECRET di website. Pakai secret acak sendiri.
WEBSITE_REVALIDATE_URL=https://alisanprinting.com
WEBSITE_REVALIDATE_SECRET=
